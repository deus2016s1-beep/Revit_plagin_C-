<Window x:Class="VentCalc.UI.Views.SpecCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecCalc — Спецификация инженерных систем"
        Width="1280" Height="780" MinWidth="1040" MinHeight="640" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="SpecCalc — Конструктор спецификаций вентиляции" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding RulesPath, StringFormat=Правила: {0}}" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding SettingsPath, StringFormat=Настройки: {0}}" /></StatusBarItem>
        </StatusBar>
        <TabControl>
            <TabItem Header="Спецификация">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Обновить" Command="{Binding CollectVentilationCommand}" Padding="12,5" Margin="0,0,6,0" />
                            <Button Content="Изменить выбранные" Command="{Binding BulkEditCommand}" Padding="12,5" Margin="0,0,6,0" />
                            <Button Content="Экспорт Excel" Command="{Binding ExportExcelCommand}" Padding="12,5" Margin="0,0,6,0" />
                            <Button Content="Показать в модели" Command="{Binding ShowSelectedElementCommand}" Padding="12,5" Margin="0,0,10,0" />
                            <TextBlock Text="Профиль Excel:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding ExcelProfiles}" SelectedItem="{Binding SelectedExcelProfile, Mode=TwoWay}" Width="190" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Раздел:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding SectionFilterOptions}" SelectedItem="{Binding SectionFilter, Mode=TwoWay}" Width="120" Margin="0,0,10,0" />
                            <TextBlock Text="Группа:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding GroupFilterOptions}" SelectedItem="{Binding GroupFilter, Mode=TwoWay}" Width="180" Margin="0,0,10,0" />
                            <TextBlock Text="Статус:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" Width="100" Margin="0,0,10,0" />
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,10,0" />
                            <Button Content="Показать только проблемы" Command="{Binding ShowOnlyProblemsCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Сбросить" Command="{Binding ResetFiltersCommand}" Padding="10,5" />
                        </WrapPanel>
                        <Expander Header="Дополнительно" Margin="0,0,0,6">
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Показать все проблемы" Command="{Binding ShowProblemsCommand}" Padding="10,5" Margin="0,0,6,0" />
                                <Button Content="Показать неопознанные" Command="{Binding ShowUnknownCommand}" Padding="10,5" Margin="0,0,6,0" />
                                <Button Content="Снять подсветку SpecCalc" Command="{Binding ClearSpecHighlightCommand}" Padding="10,5" Margin="0,0,6,0" />
                                <Button Content="Записать ADSK выбранные" Command="{Binding WriteSelectedAdskCommand}" Padding="10,5" Margin="0,0,6,0" />
                                <Button Content="Записать ADSK фильтр" Command="{Binding WriteFilteredAdskCommand}" Padding="10,5" Margin="0,0,6,0" />
                                <TextBlock Text="Область правила:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,4,0" />
                                <ComboBox ItemsSource="{Binding RuleScopeOptions}" SelectedItem="{Binding SelectedRuleScope, Mode=TwoWay}" Width="110" Margin="0,0,6,0" />
                                <Button Content="Сохранить правила" Command="{Binding SaveRulesCommand}" Padding="10,5" Margin="0,0,6,0" />
                                <Button Content="Вернуть Auto" Command="{Binding ResetAutoCommand}" Padding="10,5" />
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredSpecRows}" SelectedItem="{Binding SelectedSpecRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, Mode=TwoWay}" Width="36" />
                            <DataGridTextColumn Header="Раздел" Binding="{Binding Section}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="Тип / марка" Binding="{Binding TypeMark}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="75" IsReadOnly="True" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.##}}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Длина, м" Binding="{Binding LengthM, StringFormat={}{0:0.##}}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="Площадь, м²" Binding="{Binding AreaM2, StringFormat={}{0:0.##}}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Конструктор">
                <DockPanel Margin="6">
                    <Button DockPanel.Dock="Top" Content="Сохранить настройки конструктора" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding ColumnLayouts}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="В таблице" Binding="{Binding VisibleInMain, Mode=TwoWay}" Width="90" />
                            <DataGridCheckBoxColumn Header="В Excel" Binding="{Binding VisibleInExcel, Mode=TwoWay}" Width="80" />
                            <DataGridCheckBoxColumn Header="Группировать" Binding="{Binding GroupBy, Mode=TwoWay}" Width="100" />
                            <DataGridCheckBoxColumn Header="Суммировать" Binding="{Binding Sum, Mode=TwoWay}" Width="100" />
                            <DataGridTextColumn Header="Порядок" Binding="{Binding Order, Mode=TwoWay}" Width="80" />
                            <DataGridTextColumn Header="Поле" Binding="{Binding FieldName}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Заголовок" Binding="{Binding Header, Mode=TwoWay}" Width="180" />
                            <DataGridTextColumn Header="Формат" Binding="{Binding Format, Mode=TwoWay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Сырые данные">
                <DataGrid ItemsSource="{Binding RawRows}" SelectedItem="{Binding SelectedRawRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="FamilyName" Binding="{Binding FamilyName}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="TypeName" Binding="{Binding TypeName}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="ADSK_Наименование" Binding="{Binding AdskName}" Width="180" IsReadOnly="True" />
                        <DataGridTextColumn Header="ADSK_Марка" Binding="{Binding AdskMark}" Width="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="ADSK_Размер" Binding="{Binding AdskSize}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="System" Binding="{Binding System}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Problems" Binding="{Binding Problem}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Диагностика">
                <StackPanel Margin="12">
                    <TextBlock Text="Диагностика SpecCalc" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding TotalCount, StringFormat=Всего элементов: {0}}" />
                    <TextBlock Text="{Binding GroupCount, StringFormat=Строк спецификации: {0}}" />
                    <TextBlock Text="{Binding OkCount, StringFormat=OK: {0}}" />
                    <TextBlock Text="{Binding WarningCount, StringFormat=Warning: {0}}" />
                    <TextBlock Text="{Binding ErrorCount, StringFormat=Error: {0}}" />
                    <TextBlock Text="{Binding UnknownCount, StringFormat=Неопознано: {0}}" />
                    <TextBlock Text="{Binding MissingSizeCount, StringFormat=Без размера: {0}}" />
                    <TextBlock Text="{Binding MissingSystemCount, StringFormat=Без системы: {0}}" />
                    <TextBlock Text="{Binding MissingAdskNameCount, StringFormat=Пустой ADSK_Наименование: {0}}" />
                    <Button Content="Показать все проблемы" Command="{Binding ShowProblemsCommand}" Padding="10,5" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Правила">
                <StackPanel Margin="12">
                    <TextBlock Text="Локальные правила SpecCalc" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RulesPath}" TextWrapping="Wrap" />
                    <TextBlock Text="Правила применяются локально и не переименовывают семейства или типы Revit. Запись ADSK выполняется только отдельной кнопкой с подтверждением." TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
