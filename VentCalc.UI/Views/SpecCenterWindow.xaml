<Window x:Class="VentCalc.UI.Views.SpecCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecCalc — Спецификация инженерных систем"
        Width="1220" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="SpecCalc — Спецификация инженерных систем" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding RulesPath, StringFormat=Правила: {0}}" /></StatusBarItem>
        </StatusBar>
        <TabControl>
            <TabItem Header="Вентиляция">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Собрать вентиляцию" Command="{Binding CollectVentilationCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Экспорт Excel" Command="{Binding ExportExcelCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Показать выбранный элемент" Command="{Binding ShowSelectedElementCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Показать все проблемы" Command="{Binding ShowProblemsCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Показать неопознанные" Command="{Binding ShowUnknownCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Снять подсветку SpecCalc" Command="{Binding ClearSpecHighlightCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Записать ADSK выбранные" Command="{Binding WriteSelectedAdskCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Записать ADSK фильтр" Command="{Binding WriteFilteredAdskCommand}" Padding="10,5" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Статус:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" Width="100" Margin="0,0,10,0" />
                            <TextBlock Text="Группа:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding GroupFilterOptions}" SelectedItem="{Binding GroupFilter, Mode=TwoWay}" Width="180" Margin="0,0,10,0" />
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,10,0" ToolTip="Наименование, тип/марка, размер, система, уровень, примечание" />
                            <Button Content="Показать только проблемы" Command="{Binding ShowOnlyProblemsCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" Padding="10,5" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Область правила:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding RuleScopeOptions}" SelectedItem="{Binding SelectedRuleScope, Mode=TwoWay}" Width="120" Margin="0,0,10,0" />
                            <Button Content="Сохранить правила" Command="{Binding SaveRulesCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Вернуть Auto" Command="{Binding ResetAutoCommand}" Padding="10,5" />
                        </WrapPanel>
                        <UniformGrid Columns="4">
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Margin="0,0,6,6" Background="#FFF8F8F8"><StackPanel><TextBlock Text="Всего элементов" Foreground="#FF666666" /><TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Margin="0,0,6,6" Background="#FFF8F8F8"><StackPanel><TextBlock Text="OK" Foreground="#FF666666" /><TextBlock Text="{Binding OkCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Margin="0,0,6,6" Background="#FFF8F8F8"><StackPanel><TextBlock Text="Warning" Foreground="#FF666666" /><TextBlock Text="{Binding WarningCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Margin="0,0,0,6" Background="#FFF8F8F8"><StackPanel><TextBlock Text="Error" Foreground="#FF666666" /><TextBlock Text="{Binding ErrorCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Margin="0,0,6,0" Background="#FFF8F8F8"><StackPanel><TextBlock Text="Неопознано" Foreground="#FF666666" /><TextBlock Text="{Binding UnknownCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Margin="0,0,6,0" Background="#FFF8F8F8"><StackPanel><TextBlock Text="Без ADSK_Наименование" Foreground="#FF666666" /><TextBlock Text="{Binding MissingAdskNameCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Margin="0,0,6,0" Background="#FFF8F8F8"><StackPanel><TextBlock Text="Без размера" Foreground="#FF666666" /><TextBlock Text="{Binding MissingSizeCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8" Background="#FFF8F8F8"><StackPanel><TextBlock Text="Без системы" Foreground="#FF666666" /><TextBlock Text="{Binding MissingSystemCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredVentilationRows}" SelectedItem="{Binding SelectedVentilationRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="150" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="190" />
                            <DataGridTextColumn Header="Тип / марка" Binding="{Binding TypeMark, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="150" />
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="80" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Система" Binding="{Binding System}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Проблемы">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="Показать выбранный элемент" Command="{Binding ShowSelectedElementCommand}" Padding="10,5" Margin="0,0,6,0" />
                        <Button Content="Показать все проблемы" Command="{Binding ShowProblemsCommand}" Padding="10,5" Margin="0,0,6,0" />
                        <Button Content="Показать неопознанные" Command="{Binding ShowUnknownCommand}" Padding="10,5" Margin="0,0,6,0" />
                        <Button Content="Снять подсветку SpecCalc" Command="{Binding ClearSpecHighlightCommand}" Padding="10,5" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding ProblemRows}" SelectedItem="{Binding SelectedProblemRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Проблема" Binding="{Binding Problem}" Width="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="Тип / марка" Binding="{Binding TypeMark}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Система" Binding="{Binding System}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Отопление" IsEnabled="False"><TextBlock Text="Будет позже" Margin="12" /></TabItem>
            <TabItem Header="ВК" IsEnabled="False"><TextBlock Text="Будет позже" Margin="12" /></TabItem>
            <TabItem Header="Пожарка" IsEnabled="False"><TextBlock Text="Будет позже" Margin="12" /></TabItem>
            <TabItem Header="Дымоудаление" IsEnabled="False"><TextBlock Text="Будет позже" Margin="12" /></TabItem>
        </TabControl>
    </DockPanel>
</Window>
