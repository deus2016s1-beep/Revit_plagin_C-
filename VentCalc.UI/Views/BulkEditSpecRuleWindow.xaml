<Window x:Class="VentCalc.UI.Views.BulkEditSpecRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecCalc — Изменить выбранные" Width="520" Height="430" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Заполните только поля, которые нужно изменить. Пустые поля не применяются." TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Применить" Width="100" Margin="0,0,8,0" IsDefault="True" Click="Apply_Click" />
            <Button Content="Отмена" Width="90" IsCancel="True" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Раздел" Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SectionValue, Mode=TwoWay}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Группа" Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GroupValue, Mode=TwoWay}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование" Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NameValue, Mode=TwoWay}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип / марка" Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TypeMarkValue, Mode=TwoWay}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Размер" Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SizeValue, Mode=TwoWay}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ед. изм." Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding UnitValue, Mode=TwoWay}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Примечание" Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding NoteValue, Mode=TwoWay}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Область" Margin="0,0,8,6" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding RuleScope, Mode=TwoWay}" Margin="0,0,0,6" ToolTip="Element, Type, Family или Group"/>
            <CheckBox Grid.Row="8" Grid.Column="1" Content="Применить ко всем отфильтрованным строкам" IsChecked="{Binding TargetFiltered, Mode=TwoWay}" />
        </Grid>
    </DockPanel>
</Window>
