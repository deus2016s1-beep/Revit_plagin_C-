<Window x:Class="VentCalc.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VentCalc — Настройки"
        Width="800"
        Height="650"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Настройки VentCalc" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Click="Save_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Отмена" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Применить" Command="{Binding SaveSettingsCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Сбросить по умолчанию" Command="{Binding ResetSettingsCommand}" Padding="12,6" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TabControl>
            <TabItem Header="Воздух и расчёт">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16" MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Плотность воздуха, кг/м³" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.AirDensityKgM3, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="Обычно 1.2 кг/м³." />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Динамическая вязкость, Па·с" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.AirDynamicViscosityText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="Обычно 1.81E-5 Па·с при 20 °C." />
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Шероховатость воздуховода, мм" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.RoughnessMm, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="Для оцинкованной стали часто принимают около 0.1 мм." />
                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Запас давления, %" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.PressureReservePercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="Добавляется к итоговым потерям критической трассы." />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Скорости">
                <StackPanel Margin="16" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Минимальная скорость, м/с" /><TextBox Text="{Binding Settings.MinVelocityMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Максимальная скорость, м/с" /><TextBox Text="{Binding Settings.MaxVelocityMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Критическая скорость, м/с" /><TextBox Text="{Binding Settings.CriticalVelocityMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" Text="Перед сохранением проверяется условие: Минимальная &lt; Максимальная &lt; Критическая. Значения по умолчанию: 1 / 8 / 12 м/с." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Подсветка">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Карта скоростей" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="40" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Низкая скорость" Margin="0,4" /><Rectangle Grid.Row="0" Grid.Column="1" Fill="{Binding Settings.LowVelocityColorHex}" Stroke="#FF777777" Height="22" Margin="4" /><TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Settings.LowVelocityColorHex, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Row="0" Grid.Column="3" Content="Выбрать цвет" Command="{Binding PickLowVelocityColorCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Нормальная скорость" Margin="0,4" /><Rectangle Grid.Row="1" Grid.Column="1" Fill="{Binding Settings.NormalVelocityColorHex}" Stroke="#FF777777" Height="22" Margin="4" /><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Settings.NormalVelocityColorHex, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Row="1" Grid.Column="3" Content="Выбрать цвет" Command="{Binding PickNormalVelocityColorCommand}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Высокая скорость" Margin="0,4" /><Rectangle Grid.Row="2" Grid.Column="1" Fill="{Binding Settings.HighVelocityColorHex}" Stroke="#FF777777" Height="22" Margin="4" /><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Settings.HighVelocityColorHex, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Row="2" Grid.Column="3" Content="Выбрать цвет" Command="{Binding PickHighVelocityColorCommand}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Критическая скорость" Margin="0,4" /><Rectangle Grid.Row="3" Grid.Column="1" Fill="{Binding Settings.CriticalVelocityColorHex}" Stroke="#FF777777" Height="22" Margin="4" /><TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Settings.CriticalVelocityColorHex, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Row="3" Grid.Column="3" Content="Выбрать цвет" Command="{Binding PickCriticalVelocityColorCommand}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Критическая трасса" Margin="0,4" /><Rectangle Grid.Row="4" Grid.Column="1" Fill="{Binding Settings.CriticalPathColorHex}" Stroke="#FF777777" Height="22" Margin="4" /><TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Settings.CriticalPathColorHex, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Row="4" Grid.Column="3" Content="Выбрать цвет" Command="{Binding PickCriticalPathColorCommand}" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ошибки / предупреждения" Margin="0,4" /><Rectangle Grid.Row="5" Grid.Column="1" Fill="{Binding Settings.IssueColorHex}" Stroke="#FF777777" Height="22" Margin="4" /><TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Settings.IssueColorHex, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Row="5" Grid.Column="3" Content="Выбрать цвет" Command="{Binding PickIssueColorCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="Основной способ выбора — кнопка «Выбрать цвет» со стандартным ColorDialog. HEX остаётся как дополнительное поле и сохраняется в settings.json." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Интерфейс">
                <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
                    <CheckBox Content="Приближать модель после подсветки" IsChecked="{Binding Settings.ZoomToElementOnShow, Mode=TwoWay}" />
                    <CheckBox Content="Запоминать размер и положение окон" IsChecked="{Binding Settings.RememberWindowPlacement, Mode=TwoWay}" Margin="0,8,0,0" />
                    <CheckBox Content="Подтверждать массовые изменения ζ" IsChecked="{Binding Settings.ConfirmBulkZetaChanges, Mode=TwoWay}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Вкладка VentCalc Center после загрузки системы" />
                    <ComboBox SelectedValue="{Binding Settings.UiDefaultTabAfterLoad, Mode=TwoWay}" SelectedValuePath="Content" Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Расчёт" />
                        <ComboBoxItem Content="Местные сопротивления" />
                        <ComboBoxItem Content="Проверки" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource HintText}" Text="Вкладка после загрузки и приближение модели уже используются. Запоминание положения окон и подтверждение массовых ζ сохраняются для подключённых сценариев." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Сервис">
                <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
                    <Button Content="Открыть папку настроек" Command="{Binding OpenSettingsFolderCommand}" HorizontalAlignment="Left" Padding="10,6" />
                    <Button Content="Открыть папку отчётов" Command="{Binding OpenReportsFolderCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0" />
                    <Button Content="Сбросить настройки по умолчанию" Command="{Binding ResetSettingsCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource HintText}" Text="Перед полным сбросом будет показано подтверждение. Повреждённые HEX-цвета при чтении заменяются только на стандартные значения соответствующего цвета." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
