<Window x:Class="VentCalc.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VentCalc — Настройки"
        Width="460"
        Height="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Настройки VentCalc" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock Text="Плотность воздуха, кг/м³" /><TextBox Text="{Binding Settings.AirDensityKgM3, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Динамическая вязкость, Па·с" /><TextBox Text="{Binding Settings.AirDynamicViscosityPaS, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Шероховатость, м" /><TextBox Text="{Binding Settings.RoughnessM, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Запас, %" /><TextBox Text="{Binding Settings.ReservePercent, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Мин. скорость, м/с" /><TextBox Text="{Binding Settings.MinVelocityMs, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Макс. скорость, м/с" /><TextBox Text="{Binding Settings.MaxVelocityMs, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Критическая скорость, м/с" /><TextBox Text="{Binding Settings.CriticalVelocityMs, UpdateSourceTrigger=PropertyChanged}" />
        <WrapPanel Margin="0,14,0,0">
            <Button Content="Сохранить" Command="{Binding SaveSettingsCommand}" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="Сбросить по умолчанию" Command="{Binding ResetSettingsCommand}" Padding="10,6" />
        </WrapPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
</Window>
