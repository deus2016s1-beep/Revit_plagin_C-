<Window x:Class="VentCalc.UI.Views.VelocityHighlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VentCalc — Скорости и подсветка"
        Width="460"
        Height="220"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Настройки подсветки перенесены" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
        <StackPanel>
            <TextBlock Text="Настройки подсветки перенесены во вкладку VentCalc Center → Настройки → Подсветка." TextWrapping="Wrap" />
            <TextBlock Text="Для обычной работы используйте Ribbon-команды «Карта скоростей» и «Снять подсветку»." TextWrapping="Wrap" Foreground="#FF555555" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
