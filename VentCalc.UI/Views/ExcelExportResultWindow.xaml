<Window x:Class="VentCalc.UI.Views.ExcelExportResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel аэродинамического расчёта создан"
        Width="620"
        Height="210"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Excel аэродинамического расчёта создан"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10" />
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Открыть файл" Click="OpenFile_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Открыть папку" Click="OpenFolder_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Закрыть" IsCancel="True" Padding="12,6" />
        </WrapPanel>
        <StackPanel>
            <TextBlock Text="Путь к файлу:" FontWeight="SemiBold" />
            <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
