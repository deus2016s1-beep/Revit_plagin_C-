<Window x:Class="VentCalc.UI.Views.ProjectZetaCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог коэффициентов ζ проекта"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Каталог коэффициентов ζ проекта" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="По умолчанию показаны только роли, которые используются в загруженной системе или имеют значение проекта." Foreground="#FF666666" TextWrapping="Wrap" />
            <CheckBox Content="Все роли" IsChecked="{Binding ShowAllProjectZetaCatalogRoles, Mode=TwoWay}" Margin="4" />
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Command="{Binding SaveProjectZetaCatalogCommand}" />
            <Button Content="Вернуть выбранное" Command="{Binding ResetSelectedCatalogRoleCommand}" />
            <Button Content="Вернуть весь каталог" Command="{Binding ResetWholeCatalogCommand}" />
            <Button Content="Закрыть" Click="Close_Click" />
        </WrapPanel>
        <DataGrid ItemsSource="{Binding VisibleProjectZetaCatalogRows}" SelectedItem="{Binding SelectedProjectZetaCatalogRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Вид" Binding="{Binding LocalizedRole}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="ζ по умолчанию" Binding="{Binding AutoZeta, StringFormat={}{0:0.###}}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="ζ проекта" Binding="{Binding ProjectZetaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="Используется" Binding="{Binding EffectiveProjectZeta, StringFormat={}{0:0.###}}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="Количество" Binding="{Binding ApplicationCount}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Примечание" Binding="{Binding ValidationMessage}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
